{
  "$schema": "../../schema.json",
  "id": "types-unsigned-wrap",
  "lang": "cpp",
  "category": "types",
  "rank": 1,
  "title": {
    "chs": "无符号减法回绕",
    "en": "Unsigned Subtraction Wraps"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "both-directions",
      "label": {
        "chs": "两个方向相减",
        "en": "Subtract both ways"
      },
      "cases": [
        {
          "in": [
            "3",
            "5"
          ],
          "out": [
            "18446744073709551614 2"
          ]
        },
        {
          "in": [
            "5",
            "3"
          ],
          "out": [
            "2 18446744073709551614"
          ]
        }
      ]
    },
    {
      "id": "extremes",
      "label": {
        "chs": "极值",
        "en": "Extremes"
      },
      "cases": [
        {
          "in": [
            "18446744073709551615",
            "0"
          ],
          "out": [
            "18446744073709551615 1"
          ]
        },
        {
          "in": [
            "0",
            "18446744073709551615"
          ],
          "out": [
            "1 18446744073709551615"
          ]
        }
      ]
    },
    {
      "id": "zero",
      "label": {
        "chs": "零与相等",
        "en": "Zero and equality"
      },
      "cases": [
        {
          "in": [
            "0",
            "0"
          ],
          "out": [
            "0 0"
          ]
        },
        {
          "in": [
            "1",
            "0"
          ],
          "out": [
            "1 18446744073709551615"
          ]
        }
      ]
    },
    {
      "id": "near-max",
      "label": {
        "chs": "接近上界",
        "en": "Near the maximum"
      },
      "cases": [
        {
          "in": [
            "18446744073709551615",
            "18446744073709551614"
          ],
          "out": [
            "1 18446744073709551615"
          ]
        }
      ]
    },
    {
      "id": "word",
      "label": {
        "chs": "大于 32 位的值",
        "en": "Values wider than 32 bits"
      },
      "cases": [
        {
          "in": [
            "4294967296",
            "4294967297"
          ],
          "out": [
            "18446744073709551615 1"
          ]
        }
      ]
    }
  ]
}
