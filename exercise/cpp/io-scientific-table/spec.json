{
  "$schema": "../../schema.json",
  "id": "io-scientific-table",
  "lang": "cpp",
  "category": "io",
  "rank": 2,
  "title": {
    "chs": "科学计数法表格",
    "en": "Scientific Notation Table"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "basic",
      "label": {
        "chs": "普通正数与小数",
        "en": "Ordinary values and fractions"
      },
      "cases": [
        {
          "in": [
            "2",
            "1234 0.03125"
          ],
          "out": [
            "   1.234e+03",
            "   3.125e-02"
          ]
        }
      ]
    },
    {
      "id": "zero",
      "label": {
        "chs": "零的格式",
        "en": "Formatting zero"
      },
      "cases": [
        {
          "in": [
            "1",
            "0"
          ],
          "out": [
            "   0.000e+00"
          ]
        }
      ]
    },
    {
      "id": "negative",
      "label": {
        "chs": "负数",
        "en": "Negative values"
      },
      "cases": [
        {
          "in": [
            "2",
            "-1500 -0.125"
          ],
          "out": [
            "  -1.500e+03",
            "  -1.250e-01"
          ]
        }
      ]
    },
    {
      "id": "small",
      "label": {
        "chs": "小数量级",
        "en": "Small magnitudes"
      },
      "cases": [
        {
          "in": [
            "2",
            "0.0005 0.0000001"
          ],
          "out": [
            "   5.000e-04",
            "   1.000e-07"
          ]
        }
      ]
    },
    {
      "id": "large",
      "label": {
        "chs": "大数量级与三位指数",
        "en": "Large magnitudes and three-digit exponents"
      },
      "cases": [
        {
          "in": [
            "2",
            "100000 1e300"
          ],
          "out": [
            "   1.000e+05",
            "  1.000e+300"
          ]
        }
      ]
    },
    {
      "id": "max-count",
      "label": {
        "chs": "最多八行",
        "en": "Eight rows"
      },
      "cases": [
        {
          "in": [
            "8",
            "1 2 3 4 5 6 7 8"
          ],
          "out": [
            "   1.000e+00",
            "   2.000e+00",
            "   3.000e+00",
            "   4.000e+00",
            "   5.000e+00",
            "   6.000e+00",
            "   7.000e+00",
            "   8.000e+00"
          ]
        }
      ]
    }
  ]
}
