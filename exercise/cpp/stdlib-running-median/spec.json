{
  "$schema": "../../schema.json",
  "id": "stdlib-running-median",
  "lang": "cpp",
  "category": "stdlib",
  "rank": 4,
  "title": {
    "chs": "逐个插入的中位数",
    "en": "Running Median"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "single",
      "label": {
        "chs": "只有一个数",
        "en": "A single value"
      },
      "cases": [
        {
          "in": [
            "1",
            "5"
          ],
          "out": [
            "5"
          ]
        }
      ]
    },
    {
      "id": "sorted",
      "label": {
        "chs": "升序插入",
        "en": "Inserted ascending"
      },
      "cases": [
        {
          "in": [
            "3",
            "1 2 3"
          ],
          "out": [
            "1 1 2"
          ]
        },
        {
          "in": [
            "4",
            "10 20 30 40"
          ],
          "out": [
            "10 10 20 20"
          ]
        }
      ]
    },
    {
      "id": "descending",
      "label": {
        "chs": "降序插入",
        "en": "Inserted descending"
      },
      "cases": [
        {
          "in": [
            "5",
            "5 4 3 2 1"
          ],
          "out": [
            "5 4 4 3 3"
          ]
        }
      ]
    },
    {
      "id": "duplicates",
      "label": {
        "chs": "重复值",
        "en": "Duplicates"
      },
      "cases": [
        {
          "in": [
            "3",
            "2 2 2"
          ],
          "out": [
            "2 2 2"
          ]
        },
        {
          "in": [
            "4",
            "7 7 1 2"
          ],
          "out": [
            "7 7 7 2"
          ]
        }
      ]
    },
    {
      "id": "negatives",
      "label": {
        "chs": "负数",
        "en": "Negative values"
      },
      "cases": [
        {
          "in": [
            "3",
            "-5 -1 -3"
          ],
          "out": [
            "-5 -5 -3"
          ]
        }
      ]
    },
    {
      "id": "mixed",
      "label": {
        "chs": "混合顺序",
        "en": "Mixed order"
      },
      "cases": [
        {
          "in": [
            "8",
            "3 1 4 1 5 9 2 6"
          ],
          "out": [
            "3 1 3 1 3 3 3 3"
          ]
        }
      ]
    }
  ]
}
