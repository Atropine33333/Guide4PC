{
  "$schema": "../../schema.json",
  "id": "stdlib-erase-remove",
  "lang": "cpp",
  "category": "stdlib",
  "rank": 1,
  "title": {
    "chs": "筛掉区间外的数",
    "en": "Remove Out-of-Range Values"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "all-kept",
      "label": {
        "chs": "全部保留",
        "en": "Everything is kept"
      },
      "cases": [
        {
          "in": [
            "5 0 10",
            "1 2 3 4 5"
          ],
          "out": [
            "5",
            "1 2 3 4 5"
          ]
        }
      ]
    },
    {
      "id": "all-removed",
      "label": {
        "chs": "全部删除",
        "en": "Everything is removed"
      },
      "cases": [
        {
          "in": [
            "4 0 0",
            "1 2 3 4"
          ],
          "out": [
            "0"
          ]
        },
        {
          "in": [
            "3 5 1",
            "2 3 4"
          ],
          "out": [
            "0"
          ]
        },
        {
          "in": [
            "0 0 10"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "boundaries",
      "label": {
        "chs": "闭区间端点",
        "en": "Closed interval endpoints"
      },
      "cases": [
        {
          "in": [
            "6 3 7",
            "2 3 1 7 8 2"
          ],
          "out": [
            "2",
            "3 7"
          ]
        }
      ]
    },
    {
      "id": "middle",
      "label": {
        "chs": "删除中间的值",
        "en": "Removing values in the middle"
      },
      "cases": [
        {
          "in": [
            "7 10 20",
            "9 10 15 20 21 10 20"
          ],
          "out": [
            "5",
            "10 15 20 10 20"
          ]
        }
      ]
    },
    {
      "id": "negative",
      "label": {
        "chs": "负数区间",
        "en": "A negative interval"
      },
      "cases": [
        {
          "in": [
            "5 -5 -1",
            "-6 -5 -3 -1 0"
          ],
          "out": [
            "3",
            "-5 -3 -1"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "单个元素",
        "en": "A single element"
      },
      "cases": [
        {
          "in": [
            "1 0 0",
            "0"
          ],
          "out": [
            "1",
            "0"
          ]
        },
        {
          "in": [
            "1 1 1",
            "0"
          ],
          "out": [
            "0"
          ]
        }
      ]
    }
  ]
}
