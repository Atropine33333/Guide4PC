{
  "$schema": "../../schema.json",
  "id": "first-at-least",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 3,
  "title": { "chs": "第一个不小于它的位置", "en": "First Position At Least" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "basic",
      "label": { "chs": "普通查询", "en": "Ordinary queries" },
      "cases": [
        { "in": ["5", "1 3 3 7 10", "3", "3", "4", "0"], "out": ["2", "4", "1"] }
      ]
    },
    {
      "id": "all-smaller",
      "label": { "chs": "所有元素都更小", "en": "Every element is smaller" },
      "cases": [
        { "in": ["4", "1 2 4 8", "2", "11", "9"], "out": ["5", "5"] }
      ]
    },
    {
      "id": "duplicates",
      "label": { "chs": "重复元素取最左", "en": "Duplicates resolve to the leftmost" },
      "cases": [
        { "in": ["4", "2 2 2 2", "2", "2", "3"], "out": ["1", "5"] }
      ]
    },
    {
      "id": "single-element",
      "label": { "chs": "单元素数组", "en": "A single element" },
      "cases": [
        { "in": ["1", "7", "3", "7", "8", "6"], "out": ["1", "2", "1"] }
      ]
    },
    {
      "id": "first-and-last",
      "label": { "chs": "命中首尾元素", "en": "Hitting the first and last elements" },
      "cases": [
        { "in": ["3", "-4 0 9", "2", "-4", "9"], "out": ["1", "3"] }
      ]
    }
  ]
}
