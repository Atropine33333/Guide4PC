{
  "$schema": "../../schema.json",
  "id": "algorithm-prime-sieve",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 2,
  "title": {
    "chs": "素数筛",
    "en": "Prime Sieve"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "below-two",
      "label": {
        "chs": "小于 2",
        "en": "Below two"
      },
      "cases": [
        {
          "in": [
            "0"
          ],
          "out": [
            "0 0"
          ]
        },
        {
          "in": [
            "1"
          ],
          "out": [
            "0 0"
          ]
        }
      ]
    },
    {
      "id": "first-primes",
      "label": {
        "chs": "最前面的素数",
        "en": "The first primes"
      },
      "cases": [
        {
          "in": [
            "2"
          ],
          "out": [
            "1 2"
          ]
        },
        {
          "in": [
            "3"
          ],
          "out": [
            "2 3"
          ]
        }
      ]
    },
    {
      "id": "small-range",
      "label": {
        "chs": "小范围",
        "en": "A small range"
      },
      "cases": [
        {
          "in": [
            "10"
          ],
          "out": [
            "4 7"
          ]
        }
      ]
    },
    {
      "id": "composite-range",
      "label": {
        "chs": "含合数的范围",
        "en": "A composite-heavy range"
      },
      "cases": [
        {
          "in": [
            "100"
          ],
          "out": [
            "25 97"
          ]
        }
      ]
    },
    {
      "id": "max-range",
      "label": {
        "chs": "最大范围",
        "en": "The maximum range"
      },
      "cases": [
        {
          "in": [
            "999983"
          ],
          "out": [
            "78498 999983"
          ]
        },
        {
          "in": [
            "1000000"
          ],
          "out": [
            "78498 999983"
          ]
        }
      ]
    }
  ]
}
