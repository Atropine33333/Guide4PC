{
  "$schema": "../../schema.json",
  "id": "sorted-merge-unique",
  "lang": "cpp",
  "category": "stdlib",
  "rank": 2,
  "title": { "chs": "两支队伍的点名册", "en": "The Muster of Two Camps" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "basic",
      "label": { "chs": "普通合并", "en": "An ordinary merge" },
      "cases": [
        { "in": ["3", "1 3 5", "3", "2 3 6"], "out": ["1 2 3 5 6"] }
      ]
    },
    {
      "id": "both-empty",
      "label": { "chs": "两个数组都为空", "en": "Both arrays empty" },
      "cases": [
        { "in": ["0", "", "0", ""], "out": ["empty"] }
      ]
    },
    {
      "id": "one-empty",
      "label": { "chs": "一个数组为空", "en": "One array empty" },
      "cases": [
        { "in": ["0", "", "3", "4 4 4"], "out": ["4"] }
      ]
    },
    {
      "id": "all-duplicates",
      "label": { "chs": "合并后只剩重复元素", "en": "Merge leaves only duplicates" },
      "cases": [
        { "in": ["2", "2 2", "2", "2 2"], "out": ["2"] }
      ]
    },
    {
      "id": "negatives",
      "label": { "chs": "含负数且两段不重叠", "en": "Negatives and disjoint ranges" },
      "cases": [
        { "in": ["2", "-5 -1", "3", "0 0 7"], "out": ["-5 -1 0 7"] }
      ]
    }
  ]
}
