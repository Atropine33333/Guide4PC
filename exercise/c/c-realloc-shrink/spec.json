    { "id": "reject-out-of-range", "label": { "chs": "数目不对就回绝", "en": "Rejecting impossible sizes" } },
    { "id": "repeated-shrink", "label": { "chs": "连着缩两回", "en": "Shrinking twice in a row" } }
