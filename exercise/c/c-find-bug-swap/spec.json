{
  "$schema": "../../schema.json",
  "id": "c-find-bug-swap",
  "lang": "c",
  "category": "debugging",
  "rank": 1,
  "title": { "chs": "交换两个数（找错）", "en": "Swap Two Numbers (Debug)" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "plain",
      "label": { "chs": "普通两个数", "en": "Two ordinary numbers" },
      "cases": [
        { "in": ["3 7"], "out": ["7 3"] }
      ]
    },
    {
      "id": "equal",
      "label": { "chs": "两个数相等", "en": "Two equal numbers" },
      "cases": [
        { "in": ["5 5"], "out": ["5 5"] }
      ]
    },
    {
      "id": "negative",
      "label": { "chs": "两个负数", "en": "Two negative numbers" },
      "cases": [
        { "in": ["-4 -9"], "out": ["-9 -4"] }
      ]
    }
  ]
}
