{
  "$schema": "../../schema.json",
  "id": "c-enum-ordinal",
  "lang": "c",
  "category": "types",
  "rank": 2,
  "title": { "chs": "枚举的号", "en": "Ordinals of an Enum" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "all-four",
      "label": { "chs": "四个字母齐了", "en": "All four letters" },
      "cases": [
        { "in": ["ABCD"], "out": ["0 5 6 2"] }
      ]
    },
    {
      "id": "single-letter",
      "label": { "chs": "只问一个", "en": "Asking about one" },
      "cases": [
        { "in": ["A"], "out": ["0"] },
        { "in": ["D"], "out": ["2"] }
      ]
    },
    {
      "id": "reordered",
      "label": { "chs": "打乱顺序", "en": "A different order" },
      "cases": [
        { "in": ["DCBA"], "out": ["2 6 5 0"] },
        { "in": ["CC"], "out": ["6 6"] }
      ]
    },
    {
      "id": "mixed-length",
      "label": { "chs": "长短不一", "en": "Different lengths" },
      "cases": [
        { "in": ["BCA"], "out": ["5 6 0"] }
      ]
    }
  ]
}
