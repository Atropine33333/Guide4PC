{
  "$schema": "../../schema.json",
  "id": "c-merge-sorted",
  "lang": "c",
  "category": "algorithm",
  "rank": 3,
  "title": { "chs": "合流", "en": "Merging the Streams" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "interleaved",
      "label": { "chs": "两支交错", "en": "Interleaved streams" },
      "cases": [
        { "in": ["5", "1 4 7 10 13", "4", "2 5 8 11"], "out": ["1 2 4 5 7 8 10 11 13"] }
      ]
    },
    {
      "id": "duplicates",
      "label": { "chs": "两边都有相同的数", "en": "Shared values" },
      "cases": [
        { "in": ["3", "1 2 2", "3", "2 2 3"], "out": ["1 2 2 2 2 3"] }
      ]
    },
    {
      "id": "empty-side",
      "label": { "chs": "一边为空", "en": "One side empty" },
      "cases": [
        { "in": ["0", "", "3", "1 2 3"], "out": ["1 2 3"] },
        { "in": ["2", "1 2", "0", ""], "out": ["1 2"] }
      ]
    },
    {
      "id": "single-each",
      "label": { "chs": "两边各一个", "en": "One element each" },
      "cases": [
        { "in": ["1", "-5", "1", "5"], "out": ["-5 5"] },
        { "in": ["1", "1000000000", "1", "-1000000000"], "out": ["-1000000000 1000000000"] }
      ]
    },
    {
      "id": "disjoint-ranges",
      "label": { "chs": "两段互不相交", "en": "Disjoint ranges" },
      "cases": [
        { "in": ["3", "10 20 30", "2", "1 2"], "out": ["1 2 10 20 30"] }
      ]
    }
  ]
}
