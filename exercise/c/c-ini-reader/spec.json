{
  "$schema": "../../schema.json",
  "id": "c-ini-reader",
  "lang": "c",
  "category": "engineering",
  "rank": 4,
  "title": { "chs": "键值行", "en": "Key-Value Lines" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "sorted-keys",
      "label": { "chs": "按键排序", "en": "Sorting by key" },
      "cases": [
        { "in": ["b=2", "a=1", "c=3"], "out": ["a=1", "b=2", "c=3"] },
        { "in": ["z=9", "m=5", "a=1"], "out": ["a=1", "m=5", "z=9"] }
      ]
    },
    {
      "id": "comments-blanks",
      "label": { "chs": "注释与空行", "en": "Comments and blank lines" },
      "cases": [
        { "in": ["# header", "", "name = Alice", "   ", "age=30"], "out": ["age=30", "name=Alice"] },
        { "in": ["#only", "#comments"], "out": [] }
      ]
    },
    {
      "id": "duplicates",
      "label": { "chs": "重复的键以后来为准", "en": "A repeated key keeps the later value" },
      "cases": [
        { "in": ["x=1", "y=2", "x=9"], "out": ["x=9", "y=2"] },
        { "in": ["a=1", "a=2", "a=3"], "out": ["a=3"] }
      ]
    },
    {
      "id": "whitespace",
      "label": { "chs": "键与值两边的空白", "en": "Whitespace around keys and values" },
      "cases": [
        { "in": ["  key  =   value with spaces  ", "\t tabbed \t=\t 7 \t"], "out": ["key=value with spaces", "tabbed=7"] },
        { "in": [" k = v "], "out": ["k=v"] }
      ]
    },
    {
      "id": "skipped-lines",
      "label": { "chs": "不成形的行", "en": "Lines that do not form an entry" },
      "cases": [
        { "in": ["novalue", "=orphan", "empty=", "z=0"], "out": ["empty=", "z=0"] },
        { "in": ["=x", "plain text", "q=1"], "out": ["q=1"] }
      ]
    }
  ]
}
