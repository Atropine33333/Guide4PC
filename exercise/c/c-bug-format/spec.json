{
  "$schema": "../../schema.json",
  "id": "c-bug-format",
  "lang": "c",
  "category": "debugging",
  "rank": 2,
  "title": { "chs": "打错了样子", "en": "Printed Wrong" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "single-row",
      "label": { "chs": "只有一行", "en": "A single row" },
      "cases": [
        { "in": ["1"], "out": ["   1     1"] }
      ]
    },
    {
      "id": "three-rows",
      "label": { "chs": "三行", "en": "Three rows" },
      "cases": [
        { "in": ["3"], "out": ["   1     1", "   2     4", "   3     9"] }
      ]
    },
    {
      "id": "ten-rows",
      "label": { "chs": "十行", "en": "Ten rows" },
      "cases": [
        { "in": ["10"], "out": ["   1     1", "   2     4", "   3     9", "   4    16", "   5    25", "   6    36", "   7    49", "   8    64", "   9    81", "  10   100"] }
      ]
    },
    {
      "id": "three-digit-squares",
      "label": { "chs": "平方数到三位", "en": "Squares reach three digits" },
      "cases": [
        { "in": ["12"], "out": ["   1     1", "   2     4", "   3     9", "   4    16", "   5    25", "   6    36", "   7    49", "   8    64", "   9    81", "  10   100", "  11   121", "  12   144"] }
      ]
    }
  ]
}
