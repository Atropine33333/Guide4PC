{
  "$schema": "../../schema.json",
  "id": "c-ctype-classify",
  "lang": "c",
  "category": "stdlib",
  "rank": 2,
  "title": { "chs": "各归各", "en": "Each to Its Kind" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "letters-and-digits",
      "label": { "chs": "字母与数字", "en": "Letters and digits" },
      "cases": [
        { "in": ["Hello123"], "out": ["5 3 0 0"] },
        { "in": ["abc123ABC"], "out": ["6 3 0 0"] }
      ]
    },
    {
      "id": "spaces",
      "label": { "chs": "空格分隔", "en": "Separated by spaces" },
      "cases": [
        { "in": ["ab cd"], "out": ["4 0 1 0"] },
        { "in": ["a b c"], "out": ["3 0 2 0"] }
      ]
    },
    {
      "id": "punctuation",
      "label": { "chs": "标点归入其他", "en": "Punctuation is other" },
      "cases": [
        { "in": ["-!?."], "out": ["0 0 0 4"] },
        { "in": ["a-b!"], "out": ["2 0 0 2"] }
      ]
    },
    {
      "id": "empty-line",
      "label": { "chs": "空行", "en": "An empty line" },
      "cases": [
        { "in": [""], "out": ["0 0 0 0"] }
      ]
    },
    {
      "id": "tabs",
      "label": { "chs": "制表符也算空白", "en": "Tabs count as whitespace" },
      "cases": [
        { "in": ["\tab 9\t"], "out": ["2 1 3 0"] }
      ]
    }
  ]
}
