{
  "$schema": "../../schema.json",
  "id": "c-bug-printf",
  "lang": "c",
  "category": "debugging",
  "rank": 2,
  "title": { "chs": "格式对不上", "en": "Format Mismatch" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "plain-sum",
      "label": { "chs": "普通小数相加", "en": "An ordinary sum" },
      "cases": [
        { "in": ["1.25 2.50"], "out": ["3.75"] }
      ]
    },
    {
      "id": "carry-cents",
      "label": { "chs": "分位进位", "en": "Carrying into cents" },
      "cases": [
        { "in": ["0.05 0.10"], "out": ["0.15"] }
      ]
    },
    {
      "id": "negative-sum",
      "label": { "chs": "和为负数", "en": "A negative sum" },
      "cases": [
        { "in": ["-3.40 1.20"], "out": ["-2.20"] }
      ]
    },
    {
      "id": "cancel-out",
      "label": { "chs": "正负相消", "en": "Summing to zero" },
      "cases": [
        { "in": ["4.50 -4.50"], "out": ["0.00"] }
      ]
    },
    {
      "id": "large-sum",
      "label": { "chs": "大数相加", "en": "A large sum" },
      "cases": [
        { "in": ["9999.99 0.01"], "out": ["10000.00"] }
      ]
    }
  ]
}
