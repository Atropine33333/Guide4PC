{
  "$schema": "../../schema.json",
  "id": "c-fast-pow",
  "lang": "c",
  "category": "algorithm",
  "rank": 2,
  "title": { "chs": "两仪掌上分内力", "en": "Splitting the Inner Force" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "zero-exponent",
      "label": { "chs": "指数为零", "en": "Exponent zero" },
      "cases": [
        { "in": ["2 0 1000"], "out": ["1"] },
        { "in": ["999999999 0 1000000000"], "out": ["1"] },
        { "in": ["0 0 1"], "out": ["0"] }
      ]
    },
    {
      "id": "one-exponent",
      "label": { "chs": "指数为一", "en": "Exponent one" },
      "cases": [
        { "in": ["7 1 1000"], "out": ["7"] },
        { "in": ["999999999 1 1000000000"], "out": ["999999999"] }
      ]
    },
    {
      "id": "large-exponent",
      "label": { "chs": "大指数", "en": "A huge exponent" },
      "cases": [
        { "in": ["2 1000000000000000000 1000000007"], "out": ["719476260"] },
        { "in": ["123456789 1000000000000000000 999999937"], "out": ["499529199"] }
      ]
    },
    {
      "id": "mod-one",
      "label": { "chs": "模数为一", "en": "Modulus one" },
      "cases": [
        { "in": ["0 5 1"], "out": ["0"] },
        { "in": ["0 1000000000000000000 1"], "out": ["0"] }
      ]
    }
  ]
}
