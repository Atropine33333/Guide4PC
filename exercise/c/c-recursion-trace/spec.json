{
  "$schema": "../../schema.json",
  "id": "c-recursion-trace",
  "lang": "c",
  "category": "semantics",
  "rank": 3,
  "title": { "chs": "递归的脚印", "en": "Footprints of Recursion" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "zero",
      "label": { "chs": "零的阶乘", "en": "The factorial of zero" },
      "cases": [
        { "in": ["0"], "out": ["1 1"] }
      ]
    },
    {
      "id": "small",
      "label": { "chs": "小数", "en": "Small numbers" },
      "cases": [
        { "in": ["1"], "out": ["1 2"] },
        { "in": ["2"], "out": ["2 3"] },
        { "in": ["3"], "out": ["6 4"] }
      ]
    },
    {
      "id": "medium",
      "label": { "chs": "中段的阶乘", "en": "Middle of the range" },
      "cases": [
        { "in": ["5"], "out": ["120 6"] },
        { "in": ["7"], "out": ["5040 8"] },
        { "in": ["10"], "out": ["3628800 11"] }
      ]
    },
    {
      "id": "largest",
      "label": { "chs": "上限", "en": "The upper limit" },
      "cases": [
        { "in": ["12"], "out": ["479001600 13"] }
      ]
    }
  ]
}
