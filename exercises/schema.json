{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guide4pc.local/exercises/schema.json",
  "title": "Guide4PC exercise spec",
  "description": "Machine-readable data for one exercise. Authored by hand, validated by the build.",
  "type": "object",
  "required": [
    "id",
    "lang",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor hint; points at this file."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "lang": {
      "enum": [
        "cpp",
        "c",
        "python"
      ]
    },
    "harness": {
      "type": "string",
      "description": "Optional file compiled after the student's code (single TU), used for class-style exercises."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 60000,
          "default": 5000
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 65536
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/variant"
      }
    },
    "title": {
      "$ref": "#/definitions/label"
    }
  },
  "definitions": {
    "label": {
      "type": "object",
      "required": [
        "chs",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "chs": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stream": {
      "description": "stdin or expected stdout. Either one string, or an array with one element per line.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "in": {
          "$ref": "#/definitions/stream"
        },
        "out": {
          "$ref": "#/definitions/stream"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/case"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "starter": {
          "type": "string",
          "description": "Starter file to use instead of starter.cpp."
        },
        "forbidPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regexes that must not match the submitted source."
        }
      }
    }
  }
}
