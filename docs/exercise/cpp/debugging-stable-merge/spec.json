{
  "$schema": "../../schema.json",
  "id": "debugging-stable-merge",
  "lang": "cpp",
  "category": "debugging",
  "rank": 2,
  "title": {
    "chs": "修好归并",
    "en": "Fix the Merge"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "b-leftover",
      "label": {
        "chs": "第二个序列有剩余",
        "en": "The second sequence has leftovers"
      },
      "cases": [
        {
          "in": [
            "2 3",
            "1 4",
            "2 5 6"
          ],
          "out": [
            "1 2 4 5 6"
          ]
        }
      ]
    },
    {
      "id": "a-leftover",
      "label": {
        "chs": "第一个序列有剩余",
        "en": "The first sequence has leftovers"
      },
      "cases": [
        {
          "in": [
            "3 1",
            "1 2 3",
            "0"
          ],
          "out": [
            "0 1 2 3"
          ]
        }
      ]
    },
    {
      "id": "duplicates",
      "label": {
        "chs": "相等值都保留",
        "en": "Equal values are all kept"
      },
      "cases": [
        {
          "in": [
            "3 3",
            "1 3 5",
            "3 3 4"
          ],
          "out": [
            "1 3 3 3 4 5"
          ]
        }
      ]
    },
    {
      "id": "empty-a",
      "label": {
        "chs": "第一个序列为空",
        "en": "The first sequence is empty"
      },
      "cases": [
        {
          "in": [
            "0 3",
            "",
            "4 5 6"
          ],
          "out": [
            "4 5 6"
          ]
        }
      ]
    },
    {
      "id": "empty-b",
      "label": {
        "chs": "第二个序列为空",
        "en": "The second sequence is empty"
      },
      "cases": [
        {
          "in": [
            "2 0",
            "1 9"
          ],
          "out": [
            "1 9"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "各一个元素",
        "en": "One element each"
      },
      "cases": [
        {
          "in": [
            "1 1",
            "2",
            "1"
          ],
          "out": [
            "1 2"
          ]
        }
      ]
    }
  ]
}
