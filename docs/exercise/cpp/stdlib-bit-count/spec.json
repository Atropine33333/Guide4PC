{
  "$schema": "../../schema.json",
  "id": "stdlib-bit-count",
  "lang": "cpp",
  "category": "stdlib",
  "rank": 1,
  "title": {
    "chs": "无符号走廊 32 号房",
    "en": "Room 32 of the Unsigned Corridor"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "extremes",
      "label": {
        "chs": "零与全 1",
        "en": "Zero and all ones"
      },
      "cases": [
        {
          "in": [
            "2",
            "0 4294967295"
          ],
          "out": [
            "0",
            "32"
          ]
        },
        {
          "in": [
            "4",
            "255 256 65535 65536"
          ],
          "out": [
            "8",
            "1",
            "16",
            "1"
          ]
        }
      ]
    },
    {
      "id": "high-bit",
      "label": {
        "chs": "最高位",
        "en": "The highest bit"
      },
      "cases": [
        {
          "in": [
            "3",
            "2147483648 1073741824 1"
          ],
          "out": [
            "1",
            "1",
            "1"
          ]
        }
      ]
    },
    {
      "id": "alternating",
      "label": {
        "chs": "交替的位模式",
        "en": "Alternating bit patterns"
      },
      "cases": [
        {
          "in": [
            "3",
            "2863311530 1431655765 0"
          ],
          "out": [
            "16",
            "16",
            "0"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "单个零",
        "en": "A single zero"
      },
      "cases": [
        {
          "in": [
            "1",
            "0"
          ],
          "out": [
            "0"
          ]
        }
      ]
    }
  ]
}
