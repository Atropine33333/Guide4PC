{
  "$schema": "../../schema.json",
  "id": "range-sum-queries",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 2,
  "title": { "chs": "区间和查询", "en": "Range Sum Queries" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "basic",
      "label": { "chs": "普通查询", "en": "Ordinary queries" },
      "cases": [
        { "in": ["5", "1 2 3 4 5", "3", "1 5", "2 4", "3 3"], "out": ["15", "9", "3"] }
      ]
    },
    {
      "id": "single-element",
      "label": { "chs": "单元素数组", "en": "A single element" },
      "cases": [
        { "in": ["1", "1000000000", "2", "1 1", "1 1"], "out": ["1000000000", "1000000000"] }
      ]
    },
    {
      "id": "negatives",
      "label": { "chs": "含负数", "en": "Negative values" },
      "cases": [
        { "in": ["3", "-5 5 -5", "3", "1 3", "1 1", "2 2"], "out": ["-5", "-5", "5"] }
      ]
    },
    {
      "id": "large-sum",
      "label": { "chs": "和超过 32 位", "en": "A sum beyond 32 bits" },
      "cases": [
        { "in": ["3", "1000000000 1000000000 1000000000", "1", "1 3"], "out": ["3000000000"] }
      ]
    },
    {
      "id": "repeated-full-range",
      "label": { "chs": "重复查询整个数组", "en": "The whole array queried twice" },
      "cases": [
        { "in": ["4", "1 -1 1 -1", "2", "1 4", "1 4"], "out": ["0", "0"] }
      ]
    }
  ]
}
