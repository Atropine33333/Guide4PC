{
  "$schema": "../../schema.json",
  "id": "debugging-mode-tie",
  "lang": "cpp",
  "category": "debugging",
  "rank": 4,
  "title": {
    "chs": "修好众数",
    "en": "Fix the Mode"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "tie",
      "label": {
        "chs": "平局取较小值",
        "en": "A tie picks the smaller value"
      },
      "cases": [
        {
          "in": [
            "4",
            "1 1 2 2"
          ],
          "out": [
            "1"
          ]
        },
        {
          "in": [
            "4",
            "2 2 1 1"
          ],
          "out": [
            "1"
          ]
        }
      ]
    },
    {
      "id": "basic",
      "label": {
        "chs": "有明显众数",
        "en": "A clear mode"
      },
      "cases": [
        {
          "in": [
            "6",
            "1 2 2 3 3 3"
          ],
          "out": [
            "3"
          ]
        },
        {
          "in": [
            "5",
            "4 4 4 2 2"
          ],
          "out": [
            "4"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "只有一个元素",
        "en": "A single element"
      },
      "cases": [
        {
          "in": [
            "1",
            "7"
          ],
          "out": [
            "7"
          ]
        },
        {
          "in": [
            "1",
            "-3"
          ],
          "out": [
            "-3"
          ]
        }
      ]
    },
    {
      "id": "same",
      "label": {
        "chs": "全部相同",
        "en": "All values equal"
      },
      "cases": [
        {
          "in": [
            "5",
            "9 9 9 9 9"
          ],
          "out": [
            "9"
          ]
        }
      ]
    },
    {
      "id": "negative-tie",
      "label": {
        "chs": "负数平局",
        "en": "A tie among negative values"
      },
      "cases": [
        {
          "in": [
            "4",
            "-5 -5 -1 -1"
          ],
          "out": [
            "-5"
          ]
        },
        {
          "in": [
            "4",
            "-2 -2 0 0"
          ],
          "out": [
            "-2"
          ]
        }
      ]
    },
    {
      "id": "no-tie",
      "label": {
        "chs": "全部只出现一次",
        "en": "Every value appears once"
      },
      "cases": [
        {
          "in": [
            "3",
            "1 2 3"
          ],
          "out": [
            "1"
          ]
        },
        {
          "in": [
            "4",
            "-1 5 0 3"
          ],
          "out": [
            "-1"
          ]
        }
      ]
    },
    {
      "id": "large",
      "label": {
        "chs": "众数在末尾",
        "en": "The mode appears at the end"
      },
      "cases": [
        {
          "in": [
            "7",
            "1 2 3 4 4 4 4"
          ],
          "out": [
            "4"
          ]
        }
      ]
    }
  ]
}
