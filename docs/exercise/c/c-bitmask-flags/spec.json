{
  "$schema": "../../schema.json",
  "id": "c-bitmask-flags",
  "lang": "c",
  "category": "syntax",
  "rank": 3,
  "title": { "chs": "位旗", "en": "Bit Flags" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "set-clear",
      "label": { "chs": "置位与清位", "en": "Set and clear" },
      "cases": [
        { "in": ["set 0", "set 7"], "out": ["1", "129"] },
        { "in": ["set 3", "set 3", "clear 3"], "out": ["8", "8", "0"] }
      ]
    },
    {
      "id": "toggle",
      "label": { "chs": "翻转位", "en": "Toggling" },
      "cases": [
        { "in": ["toggle 0", "toggle 0"], "out": ["1", "0"] },
        { "in": ["toggle 7", "toggle 0", "toggle 7"], "out": ["128", "129", "1"] }
      ]
    },
    {
      "id": "test",
      "label": { "chs": "察看位", "en": "Testing bits" },
      "cases": [
        { "in": ["test 0", "set 2", "test 2"], "out": ["0 0", "4", "4 1"] },
        { "in": ["set 5", "test 5", "clear 5", "test 5"], "out": ["32", "32 1", "0", "0 0"] }
      ]
    },
    {
      "id": "edge-bits",
      "label": { "chs": "两端的位", "en": "Bits at both ends" },
      "cases": [
        { "in": ["set 7", "test 7", "set 0", "test 0"], "out": ["128", "128 1", "129", "129 1"] },
        { "in": ["clear 0", "test 0", "toggle 7", "test 7"], "out": ["0", "0 0", "128", "128 1"] }
      ]
    },
    {
      "id": "repeated",
      "label": { "chs": "重复下令", "en": "Repeated commands" },
      "cases": [
        { "in": ["set 4", "set 4", "clear 4", "clear 4"], "out": ["16", "16", "0", "0"] }
      ]
    }
  ]
}
