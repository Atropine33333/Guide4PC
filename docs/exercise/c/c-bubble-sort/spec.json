{
  "$schema": "../../schema.json",
  "id": "c-bubble-sort",
  "lang": "c",
  "category": "algorithm",
  "rank": 2,
  "title": { "chs": "冒泡", "en": "Bubbling Up" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "already-ascending",
      "label": { "chs": "本来就有序", "en": "Already ascending" },
      "cases": [
        { "in": ["5", "1 2 3 4 5"], "out": ["1 2 3 4 5"] }
      ]
    },
    {
      "id": "fully-reversed",
      "label": { "chs": "完全逆序", "en": "Fully reversed" },
      "cases": [
        { "in": ["5", "5 4 3 2 1"], "out": ["1 2 3 4 5"] }
      ]
    },
    {
      "id": "repeated-values",
      "label": { "chs": "有重复的数", "en": "Repeated values" },
      "cases": [
        { "in": ["6", "3 1 3 2 1 2"], "out": ["1 1 2 2 3 3"] }
      ]
    },
    {
      "id": "single-value",
      "label": { "chs": "只有一个数", "en": "A single value" },
      "cases": [
        { "in": ["1", "-7"], "out": ["-7"] }
      ]
    },
    {
      "id": "negatives",
      "label": { "chs": "含有负数", "en": "With negatives" },
      "cases": [
        { "in": ["4", "0 -5 3 -5"], "out": ["-5 -5 0 3"] },
        { "in": ["3", "-1000000000 1000000000 0"], "out": ["-1000000000 0 1000000000"] }
      ]
    }
  ]
}
