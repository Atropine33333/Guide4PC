{
  "$schema": "../../schema.json",
  "id": "c-sparse-matrix",
  "lang": "c",
  "category": "data",
  "rank": 4,
  "title": { "chs": "稀疏的格子", "en": "Sparse Grid" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "basic-transpose",
      "label": { "chs": "普通矩阵转置", "en": "Transposing an ordinary matrix" },
      "cases": [
        {
          "in": ["3 4 4", "0 1 5", "1 3 -2", "2 0 7", "2 2 9"],
          "out": ["4 3 4", "0 2 7", "1 0 5", "2 2 9", "3 1 -2"]
        },
        {
          "in": ["1 1 1", "0 0 -4"],
          "out": ["1 1 1", "0 0 -4"]
        }
      ]
    },
    {
      "id": "empty-grid",
      "label": { "chs": "没有非零元素", "en": "A grid with no nonzero entries" },
      "cases": [
        { "in": ["5 3 0"], "out": ["3 5 0"] }
      ]
    },
    {
      "id": "single-line",
      "label": { "chs": "单行与单列", "en": "A single row and a single column" },
      "cases": [
        {
          "in": ["1 5 3", "0 0 1", "0 2 2", "0 4 3"],
          "out": ["5 1 3", "0 0 1", "2 0 2", "4 0 3"]
        },
        {
          "in": ["5 1 3", "0 0 10", "2 0 20", "4 0 30"],
          "out": ["1 5 3", "0 0 10", "0 2 20", "0 4 30"]
        }
      ]
    },
    {
      "id": "unsorted-input",
      "label": { "chs": "三元组乱序给出", "en": "Triplets given out of order" },
      "cases": [
        {
          "in": ["3 3 5", "2 2 9", "0 0 -1", "1 2 5", "2 0 8", "0 1 4"],
          "out": ["3 3 5", "0 0 -1", "0 2 8", "1 0 4", "2 1 5", "2 2 9"]
        }
      ]
    },
    {
      "id": "wide-values",
      "label": { "chs": "正负大数值", "en": "Large values of both signs" },
      "cases": [
        {
          "in": ["2 2 2", "0 1 -1000000000", "1 0 1000000000"],
          "out": ["2 2 2", "0 1 1000000000", "1 0 -1000000000"]
        }
      ]
    }
  ]
}
