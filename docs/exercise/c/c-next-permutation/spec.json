{
  "$schema": "../../schema.json",
  "id": "c-next-permutation",
  "lang": "c",
  "category": "algorithm",
  "rank": 4,
  "title": { "chs": "下一个排列", "en": "The Next Arrangement" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "middle",
      "label": { "chs": "普通推进", "en": "An ordinary step forward" },
      "cases": [
        { "in": ["3", "1 2 3"], "out": ["1 3 2"] },
        { "in": ["5", "1 5 3 4 2"], "out": ["1 5 4 2 3"] }
      ]
    },
    {
      "id": "wrap",
      "label": { "chs": "尾部进位", "en": "A carry at the tail" },
      "cases": [
        { "in": ["3", "1 3 2"], "out": ["2 1 3"] },
        { "in": ["5", "1 2 3 5 4"], "out": ["1 2 4 3 5"] }
      ]
    },
    {
      "id": "last",
      "label": { "chs": "最后一个排列", "en": "The final arrangement" },
      "cases": [
        { "in": ["3", "3 2 1"], "out": ["none"] },
        { "in": ["1", "1"], "out": ["none"] }
      ]
    },
    {
      "id": "tail",
      "label": { "chs": "长尾后缀", "en": "A long descending tail" },
      "cases": [
        { "in": ["4", "1 3 4 2"], "out": ["1 4 2 3"] },
        { "in": ["6", "2 4 6 5 3 1"], "out": ["2 5 1 3 4 6"] }
      ]
    }
  ]
}
