{
  "$schema": "../../schema.json",
  "id": "data-trie-prefix",
  "lang": "cpp",
  "category": "data",
  "rank": 4,
  "title": {
    "chs": "前缀树计数",
    "en": "Trie Prefix Counting"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "harness": "harness.cpp",
  "checks": [
    {
      "id": "empty",
      "label": {
        "chs": "空树",
        "en": "An empty trie"
      }
    },
    {
      "id": "chain",
      "label": {
        "chs": "一条链上的单词",
