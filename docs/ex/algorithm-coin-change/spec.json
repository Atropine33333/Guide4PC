{
  "$schema": "../../schema.json",
  "id": "algorithm-coin-change",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 3,
  "title": {
    "chs": "最少硬币数",
    "en": "Minimum Coin Change"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "zero-target",
      "label": {
        "chs": "目标为零",
        "en": "A zero target"
      },
      "cases": [
        {
          "in": [
            "2 0",
            "5 7"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "one-coin",
      "label": {
        "chs": "恰好一枚",
        "en": "Exactly one coin"
      },
      "cases": [
        {
          "in": [
            "2 7",
            "5 7"
          ],
          "out": [
            "1"
          ]
        }
      ]
    },
    {
      "id": "greedy-fails",
      "label": {
        "chs": "贪心会失败的情形",
        "en": "A case where greedy fails"
      },
      "cases": [
        {
          "in": [
            "3 6",
            "1 3 4"
          ],
          "out": [
            "2"
          ]
        }
      ]
    },
    {
      "id": "unreachable",
      "label": {
        "chs": "无法凑出",
        "en": "An unreachable target"
      },
      "cases": [
        {
          "in": [
            "2 7",
            "2 4"
          ],
          "out": [
            "-1"
          ]
        },
        {
          "in": [
            "1 5",
            "3"
          ],
          "out": [
            "-1"
          ]
        }
      ]
    },
    {
      "id": "classic",
      "label": {
        "chs": "需要组合的面额",
        "en": "Denominations that must be combined"
      },
      "cases": [
        {
          "in": [
            "4 11",
            "1 5 6 9"
          ],
          "out": [
            "2"
          ]
        }
      ]
    },
    {
      "id": "large-target",
      "label": {
        "chs": "较大目标",
        "en": "A larger target"
      },
      "cases": [
        {
          "in": [
            "3 100",
            "1 2 5"
          ],
          "out": [
            "20"
          ]
        }
      ]
    }
  ]
}
