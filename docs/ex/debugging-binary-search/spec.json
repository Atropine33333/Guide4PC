{
  "$schema": "../../schema.json",
  "id": "debugging-binary-search",
  "lang": "cpp",
  "category": "debugging",
  "rank": 4,
  "title": {
    "chs": "下界查找（找错）",
    "en": "Lower Bound (Debug)"
  },
  "harness": "harness.cpp",
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "empty",
      "label": {
        "chs": "空序列",
        "en": "An empty sequence"
      }
    },
    {
      "id": "single",
      "label": {
        "chs": "单元素",
        "en": "A single element"
      }
    },
    {
      "id": "duplicates",
      "label": {
        "chs": "重复元素取第一个",
        "en": "The first of duplicates"
      }
    },
    {
      "id": "missing",
      "label": {
        "chs": "目标不存在",
        "en": "A missing target"
      }
    },
    {
      "id": "negative",
      "label": {
        "chs": "负数",
        "en": "Negative values"
      }
    },
    {
      "id": "large",
      "label": {
        "chs": "较长序列",
        "en": "A longer sequence"
      }
    },
    {
      "id": "all-equal",
      "label": {
        "chs": "全部相等",
        "en": "All values equal"
      }
    }
  ]
}
