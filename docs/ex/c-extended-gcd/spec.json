{
  "$schema": "../../schema.json",
  "id": "c-extended-gcd",
  "lang": "c",
  "category": "algorithm",
  "rank": 3,
  "title": {
    "chs": "两帮合阵的调度令",
    "en": "The Marshal's Dispatch"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "coprime",
      "label": {
        "chs": "互质的一对",
        "en": "A coprime pair"
      },
      "cases": [
        {
          "in": [
            "7 5"
          ],
          "out": [
            "1 3 -4"
          ]
        },
        {
          "in": [
            "17 23"
          ],
          "out": [
            "1 19 -14"
          ]
        }
      ]
    },
    {
      "id": "common-factor",
      "label": {
        "chs": "有公因数",
        "en": "Sharing a factor"
      },
      "cases": [
        {
          "in": [
            "12 8"
          ],
          "out": [
            "4 1 -1"
          ]
        },
        {
          "in": [
            "36 60"
          ],
          "out": [
            "12 2 -1"
          ]
        }
      ]
    },
    {
      "id": "equal",
      "label": {
        "chs": "两数相等",
        "en": "Equal numbers"
      },
      "cases": [
        {
          "in": [
            "9 9"
          ],
          "out": [
            "9 0 1"
          ]
        },
        {
          "in": [
            "1000000000 1000000000"
          ],
          "out": [
            "1000000000 0 1"
          ]
        }
      ]
    },
    {
      "id": "large",
      "label": {
        "chs": "大数",
        "en": "Large numbers"
      },
      "cases": [
        {
          "in": [
            "1 1000000000"
          ],
          "out": [
            "1 1 0"
          ]
        },
        {
          "in": [
            "999999937 1000000000"
          ],
          "out": [
            "1 873015873 -873015818"
          ]
        }
      ]
    }
  ]
}
