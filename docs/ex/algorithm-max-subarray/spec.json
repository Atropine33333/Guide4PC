{
  "$schema": "../../schema.json",
  "id": "algorithm-max-subarray",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 3,
  "title": {
    "chs": "最大子段和",
    "en": "Maximum Subarray Sum"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "all-negative",
      "label": {
        "chs": "全是负数",
        "en": "All negative"
      },
      "cases": [
        {
          "in": [
            "3",
            "-5 -2 -9"
          ],
          "out": [
            "-2"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "单个元素",
        "en": "A single element"
      },
      "cases": [
        {
          "in": [
            "1",
            "7"
          ],
          "out": [
            "7"
          ]
        }
      ]
    },
    {
      "id": "mixed",
      "label": {
        "chs": "正负混合",
        "en": "Mixed signs"
      },
      "cases": [
        {
          "in": [
            "7",
            "1 -2 3 4 -1 2 -5"
          ],
          "out": [
            "8"
          ]
        }
      ]
    },
    {
      "id": "all-positive",
      "label": {
        "chs": "全是正数",
        "en": "All positive"
      },
      "cases": [
        {
          "in": [
            "3",
            "1 2 3"
          ],
          "out": [
            "6"
          ]
        }
      ]
    },
    {
      "id": "zeros",
      "label": {
        "chs": "含零",
        "en": "Zeros included"
      },
      "cases": [
        {
          "in": [
            "3",
            "-1 0 -2"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "large-sum",
      "label": {
        "chs": "大和",
        "en": "A large sum"
      },
      "cases": [
        {
          "in": [
            "3",
            "1000000000 -1 1000000000"
          ],
          "out": [
            "1999999999"
          ]
        }
      ]
    }
  ]
}
