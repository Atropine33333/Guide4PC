{
  "$schema": "../../schema.json",
  "id": "c-endian-pack",
  "lang": "c",
  "category": "engineering",
  "rank": 4,
  "title": { "chs": "打包成字节", "en": "Packing into Bytes" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "typical",
      "label": { "chs": "两个常见值", "en": "Two familiar values" },
      "cases": [
        { "in": ["305419896"], "out": ["78 56 34 12"] },
        { "in": ["16909060"], "out": ["04 03 02 01"] }
      ]
    },
    {
      "id": "zero",
      "label": { "chs": "全零", "en": "All zeros" },
      "cases": [
        { "in": ["0"], "out": ["00 00 00 00"] }
      ]
    },
    {
      "id": "one",
      "label": { "chs": "只有最低位", "en": "Only the lowest byte" },
      "cases": [
        { "in": ["1"], "out": ["01 00 00 00"] }
      ]
    },
    {
      "id": "all-bits",
      "label": { "chs": "三十二位全满", "en": "All thirty-two bits set" },
      "cases": [
        { "in": ["4294967295"], "out": ["FF FF FF FF"] }
      ]
    },
    {
      "id": "high-bit",
      "label": { "chs": "最高位单独点亮", "en": "Only the highest bit set" },
      "cases": [
        { "in": ["2147483648"], "out": ["00 00 00 80"] }
      ]
    }
  ]
}
