{
  "$schema": "../../schema.json",
  "id": "c-binary-search",
  "lang": "c",
  "category": "algorithm",
  "rank": 3,
  "title": { "chs": "二分", "en": "Halving" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "first-slot",
      "label": { "chs": "命中第一个", "en": "Hit at the first slot" },
      "cases": [
        { "in": ["7", "1 3 5 7 9 11 13", "1"], "out": ["0"] }
      ]
    },
    {
      "id": "last-slot",
      "label": { "chs": "命中最后一个", "en": "Hit at the last slot" },
      "cases": [
        { "in": ["7", "1 3 5 7 9 11 13", "13"], "out": ["6"] }
      ]
    },
    {
      "id": "middle",
      "label": { "chs": "命中中间", "en": "Hit in the middle" },
      "cases": [
        { "in": ["7", "1 3 5 7 9 11 13", "7"], "out": ["3"] },
        { "in": ["8", "-9 -4 0 2 5 8 12 30", "0"], "out": ["2"] }
      ]
    },
    {
      "id": "missing",
      "label": { "chs": "找不到", "en": "Not present" },
      "cases": [
        { "in": ["7", "1 3 5 7 9 11 13", "4"], "out": ["-1"] },
        { "in": ["7", "1 3 5 7 9 11 13", "100"], "out": ["-1"] }
      ]
    },
    {
      "id": "single-element",
      "label": { "chs": "只有一个元素", "en": "A single element" },
      "cases": [
        { "in": ["1", "42", "42"], "out": ["0"] },
        { "in": ["1", "42", "7"], "out": ["-1"] }
      ]
    }
  ]
}
