{
  "$schema": "../../schema.json",
  "id": "stdlib-pivot-partition",
  "lang": "cpp",
  "category": "stdlib",
  "rank": 3,
  "title": {
    "chs": "稳定的三路划分",
    "en": "Stable Three-Way Partition"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "mixed",
      "label": {
        "chs": "普通划分",
        "en": "Ordinary partition"
      },
      "cases": [
        {
          "in": [
            "6 10",
            "5 12 3 10 7 10"
          ],
          "out": "5 3 7 10 10 12"
        }
      ]
    },
    {
      "id": "pivot-absent",
      "label": {
        "chs": "枢轴不存在",
        "en": "Pivot absent"
      },
      "cases": [
        {
          "in": [
            "4 9",
            "4 1 2 3"
          ],
          "out": "4 1 2 3"
        }
      ]
    },
    {
      "id": "all-equal",
      "label": {
        "chs": "全部等于枢轴",
        "en": "All equal to the pivot"
      },
      "cases": [
        {
          "in": [
            "3 7",
            "7 7 7"
          ],
          "out": "7 7 7"
        }
      ]
    },
    {
      "id": "negative",
      "label": {
        "chs": "负数",
        "en": "Negative values"
      },
      "cases": [
        {
          "in": [
            "5 -2",
            "-1 -2 -1 -3 -2"
          ],
          "out": "-3 -2 -2 -1 -1"
        }
      ]
    },
    {
      "id": "stability",
      "label": {
        "chs": "相对顺序保持不变",
        "en": "Relative order preserved"
      },
      "cases": [
        {
          "in": [
            "6 3",
            "3 1 4 2 6 5"
          ],
          "out": "1 2 3 4 6 5"
        }
      ]
    },
    {
      "id": "pivot-small",
      "label": {
        "chs": "枢轴比所有数都小",
        "en": "Pivot below everything"
      },
      "cases": [
        {
          "in": [
            "4 -100",
            "5 -3 0 2"
          ],
          "out": "5 -3 0 2"
        }
      ]
    },
    {
      "id": "pivot-large",
      "label": {
        "chs": "枢轴比所有数都大",
        "en": "Pivot above everything"
      },
      "cases": [
        {
          "in": [
            "4 100",
            "5 -3 0 2"
          ],
          "out": "5 -3 0 2"
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "单个元素",
        "en": "Single element"
      },
      "cases": [
        {
          "in": [
            "1 0",
            "0"
          ],
          "out": "0"
        }
      ]
    }
  ]
}
