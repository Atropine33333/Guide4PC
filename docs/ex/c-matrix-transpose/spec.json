{
  "$schema": "../../schema.json",
  "id": "c-matrix-transpose",
  "lang": "c",
  "category": "data",
  "rank": 3,
  "title": { "chs": "翻个面", "en": "Turn It Over" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "rectangular",
      "label": { "chs": "普通矩形", "en": "A plain rectangle" },
      "cases": [
        { "in": ["2 3", "1 2 3", "4 5 6"], "out": ["1 4", "2 5", "3 6"] },
        { "in": ["3 2", "1 2", "3 4", "5 6"], "out": ["1 3 5", "2 4 6"] }
      ]
    },
    {
      "id": "square",
      "label": { "chs": "方阵", "en": "A square matrix" },
      "cases": [
        { "in": ["3 3", "1 2 3", "4 5 6", "7 8 9"], "out": ["1 4 7", "2 5 8", "3 6 9"] }
      ]
    },
    {
      "id": "single-row",
      "label": { "chs": "只有一行", "en": "A single row" },
      "cases": [
        { "in": ["1 4", "-1 0 7 -3"], "out": ["-1", "0", "7", "-3"] }
      ]
    },
    {
      "id": "single-column",
      "label": { "chs": "只有一列", "en": "A single column" },
      "cases": [
        { "in": ["3 1", "5", "-2", "0"], "out": ["5 -2 0"] }
      ]
    },
    {
      "id": "one-cell",
      "label": { "chs": "一个数", "en": "A single value" },
      "cases": [
        { "in": ["1 1", "42"], "out": ["42"] }
      ]
    }
  ]
}
