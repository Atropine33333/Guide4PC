{
  "$schema": "../../schema.json",
  "id": "c-big-add",
  "lang": "c",
  "category": "algorithm",
  "rank": 4,
  "title": { "chs": "大数相加", "en": "Adding Big Numbers" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "carry",
      "label": { "chs": "进位一路带到头", "en": "A carry all the way up" },
      "cases": [
        { "in": ["999999999999999999999", "1"], "out": ["1000000000000000000000"] },
        { "in": ["12345678901234567890", "98765432109876543210"], "out": ["111111111011111111100"] }
      ]
    },
    {
      "id": "different-lengths",
      "label": { "chs": "两数位数不同", "en": "Operands of different lengths" },
      "cases": [
        { "in": ["12345", "678"], "out": ["13023"] },
        { "in": ["999", "1"], "out": ["1000"] }
      ]
    },
    {
      "id": "zero",
      "label": { "chs": "含零", "en": "With zeros" },
      "cases": [
        { "in": ["0", "0"], "out": ["0"] },
        { "in": ["0", "123456789"], "out": ["123456789"] }
      ]
    },
    {
      "id": "single-digit",
      "label": { "chs": "一位数相加", "en": "Single digits" },
      "cases": [
        { "in": ["7", "8"], "out": ["15"] }
      ]
    },
    {
      "id": "long",
      "label": { "chs": "六十位长数", "en": "Sixty-digit numbers" },
      "cases": [
        { "in": ["123456789012345678901234567890123456789012345678901234567890", "123456789012345678901234567890123456789012345678901234567890"], "out": ["246913578024691357802469135780246913578024691357802469135780"] }
      ]
    }
  ]
}
