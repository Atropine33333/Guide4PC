{
  "$schema": "../../schema.json",
  "id": "algorithm-fast-pow",
  "lang": "cpp",
  "category": "algorithm",
  "rank": 2,
  "title": {
    "chs": "一尺之棰",
    "en": "The Rod of a Foot"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "basic",
      "label": {
        "chs": "普通指数",
        "en": "An ordinary exponent"
      },
      "cases": [
        {
          "in": [
            "2 10 1000"
          ],
          "out": [
            "24"
          ]
        },
        {
          "in": [
            "3 5 100"
          ],
          "out": [
            "43"
          ]
        }
      ]
    },
    {
      "id": "zero-exponent",
      "label": {
        "chs": "指数为零",
        "en": "A zero exponent"
      },
      "cases": [
        {
          "in": [
            "7 0 13"
          ],
          "out": [
            "1"
          ]
        },
        {
          "in": [
            "0 0 1"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "zero-base",
      "label": {
        "chs": "底数为零",
        "en": "A zero base"
      },
      "cases": [
        {
          "in": [
            "0 5 7"
          ],
          "out": [
            "0"
          ]
        },
        {
          "in": [
            "0 1000000000000000000 1000"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "mod-one",
      "label": {
        "chs": "模数为 1",
        "en": "Modulus one"
      },
      "cases": [
        {
          "in": [
            "123456789 987654321 1"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "large-exponent",
      "label": {
        "chs": "超大指数",
        "en": "A huge exponent"
      },
      "cases": [
        {
          "in": [
            "2 1000000000000000000 1000000007"
          ],
          "out": [
            "719476260"
          ]
        },
        {
          "in": [
            "999999999 123456789 1000000007"
          ],
          "out": [
            "54470474"
          ]
        }
      ]
    },
    {
      "id": "overflow",
      "label": {
        "chs": "中间乘积接近 64 位上限",
        "en": "Products near the 64-bit limit"
      },
      "cases": [
        {
          "in": [
            "1000000000 2 999999937"
          ],
          "out": [
            "3969"
          ]
        },
        {
          "in": [
            "999999999 2 1000000000"
          ],
          "out": [
            "1"
          ]
        }
      ]
    }
  ]
}
