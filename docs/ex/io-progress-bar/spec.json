{
  "$schema": "../../schema.json",
  "id": "io-progress-bar",
  "lang": "cpp",
  "category": "io",
  "rank": 1,
  "title": {
    "chs": "文本进度条",
    "en": "Text Progress Bar"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "empty-bar",
      "label": {
        "chs": "零进度",
        "en": "Zero progress"
      },
      "cases": [
        {
          "in": [
            "0 10"
          ],
          "out": [
            "[----------] 0%"
          ]
        }
      ]
    },
    {
      "id": "full-bar",
      "label": {
        "chs": "满进度",
        "en": "Full progress"
      },
      "cases": [
        {
          "in": [
            "100 10"
          ],
          "out": [
            "[##########] 100%"
          ]
        }
      ]
    },
    {
      "id": "half",
      "label": {
        "chs": "正好一半",
        "en": "Exactly half"
      },
      "cases": [
        {
          "in": [
            "50 10"
          ],
          "out": [
            "[#####-----] 50%"
          ]
        }
      ]
    },
    {
      "id": "round-down",
      "label": {
        "chs": "向下取整",
        "en": "Rounding down"
      },
      "cases": [
        {
          "in": [
            "33 10"
          ],
          "out": [
            "[###-------] 33%"
          ]
        },
        {
          "in": [
            "99 10"
          ],
          "out": [
            "[#########-] 99%"
          ]
        },
        {
          "in": [
            "35 10"
          ],
          "out": [
            "[###-------] 35%"
          ]
        }
      ]
    },
    {
      "id": "width-one",
      "label": {
        "chs": "宽度为一",
        "en": "A width of one"
      },
      "cases": [
        {
          "in": [
            "0 1"
          ],
          "out": [
            "[-] 0%"
          ]
        },
        {
          "in": [
            "100 1"
          ],
          "out": [
            "[#] 100%"
          ]
        },
        {
          "in": [
            "50 1"
          ],
          "out": [
            "[-] 50%"
          ]
        }
      ]
    },
    {
      "id": "width-fifty",
      "label": {
        "chs": "最大宽度",
        "en": "The maximum width"
      },
      "cases": [
        {
          "in": [
            "1 50"
          ],
          "out": [
            "[--------------------------------------------------] 1%"
          ]
        },
        {
          "in": [
            "100 50"
          ],
          "out": [
            "[##################################################] 100%"
          ]
        }
      ]
    }
  ]
}
