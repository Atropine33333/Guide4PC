{
  "$schema": "../../schema.json",
  "id": "count-digit-occurrences",
  "title": {
    "chs": "数字出现计数",
    "en": "Count Digit Occurrences"
  },
  "lang": "cpp",
  "category": "syntax",
  "rank": 3,
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "empty-range",
      "label": {
        "chs": "空区间",
        "en": "An empty range"
      },
      "cases": [
        {
          "in": [
            "0",
            "3"
          ],
          "out": [
            "0"
          ]
        }
      ]
    },
    {
      "id": "single",
      "label": {
        "chs": "只有一位",
        "en": "A single digit"
      },
      "cases": [
        {
          "in": [
            "7",
            "7"
          ],
          "out": [
            "1"
          ]
        }
      ]
    },
    {
      "id": "example",
      "label": {
        "chs": "1 到 20",
        "en": "One through twenty"
      },
      "cases": [
        {
          "in": [
            "20",
            "1"
          ],
          "out": [
            "12"
          ]
        }
      ]
    },
    {
      "id": "zeros",
      "label": {
        "chs": "数字 0 与前导零",
        "en": "Zeros and leading zeros"
      },
      "cases": [
        {
          "in": [
            "100",
            "0"
          ],
          "out": [
            "11"
          ]
        }
      ]
    },
    {
      "id": "nines",
      "label": {
        "chs": "全是 9",
        "en": "All nines"
      },
      "cases": [
        {
          "in": [
            "99",
            "9"
          ],
          "out": [
            "20"
          ]
        }
      ]
    },
    {
      "id": "large",
      "label": {
        "chs": "大范围",
        "en": "A large range"
      },
      "cases": [
        {
          "in": [
            "100000000000000000",
            "1"
          ],
          "out": [
            "170000000000000001"
          ]
        }
      ]
    }
  ]
}
