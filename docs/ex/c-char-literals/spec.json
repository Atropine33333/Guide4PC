{
  "$schema": "../../schema.json",
  "id": "c-char-literals",
  "lang": "c",
  "category": "syntax",
  "rank": 2,
  "title": { "chs": "字面量的数", "en": "Numbers of Literals" },
  "limits": { "timeoutMs": 5000, "outputBytes": 65536 },
  "checks": [
    {
      "id": "letter-a",
      "label": { "chs": "从 A 出发", "en": "Starting from A" },
      "cases": [
        { "in": ["0"], "out": ["65 10 65 92 48"] }
      ]
    },
    {
      "id": "shifted-letter",
      "label": { "chs": "往后挪几位", "en": "A few letters along" },
      "cases": [
        { "in": ["2"], "out": ["67 10 65 92 48"] },
        { "in": ["13"], "out": ["78 10 65 92 48"] }
      ]
    },
    {
      "id": "last-letter",
      "label": { "chs": "字母表的末尾", "en": "The end of the alphabet" },
      "cases": [
        { "in": ["25"], "out": ["90 10 65 92 48"] }
      ]
    }
  ]
}
