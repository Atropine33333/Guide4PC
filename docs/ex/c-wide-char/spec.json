{
  "$schema": "../../schema.json",
  "id": "c-wide-char",
  "lang": "c",
  "category": "types",
  "rank": 4,
  "title": {
    "chs": "宽字符的点名",
    "en": "Calling the Wide Chars"
  },
  "limits": {
    "timeoutMs": 5000,
    "outputBytes": 65536
  },
  "checks": [
    {
      "id": "two-letters",
      "label": {
        "chs": "两个字母",
        "en": "Two letters"
      },
      "cases": [
        {
          "in": [
            "Hi"
          ],
          "out": [
            "72 105"
          ]
        }
      ]
    },
    {
      "id": "with-space",
      "label": {
        "chs": "中间一个空格",
        "en": "A space in the middle"
      },
      "cases": [
        {
          "in": [
            "A B"
          ],
          "out": [
            "65 32 66"
          ]
        }
      ]
    },
    {
      "id": "mixed",
      "label": {
        "chs": "字母数字标点",
        "en": "Letters, digits and punctuation"
      },
      "cases": [
        {
          "in": [
            "a1!"
          ],
          "out": [
            "97 49 33"
          ]
        }
      ]
    },
    {
      "id": "edges",
      "label": {
        "chs": "可见字符的两头",
        "en": "Both ends of the printable range"
      },
      "cases": [
        {
          "in": [
            " ~"
          ],
          "out": [
            "32 126"
          ]
        }
      ]
    },
    {
      "id": "empty-line",
      "label": {
        "chs": "空行",
        "en": "An empty line"
      },
      "cases": [
        {
          "in": [
            ""
          ],
          "out": [
            ""
          ]
        }
      ]
    }
  ]
}
