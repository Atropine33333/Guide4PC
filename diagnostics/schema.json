{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guide4pc.local/diagnostics/rules.schema.json",
  "title": "Guide4PC diagnostic rules (v2)",
  "type": "object",
  "required": ["lang", "rules"],
  "additionalProperties": false,
  "properties": {
    "lang": { "enum": ["cpp", "py"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "required": ["chs", "en", "ja"],
      "additionalProperties": false,
      "properties": {
        "chs": { "type": "string", "maxLength": 400 },
        "en": { "type": "string", "maxLength": 600 },
        "ja": { "type": "string", "maxLength": 600 }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "category", "when", "human", "hint", "tests"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": {
          "enum": ["语法", "名字与作用域", "类型", "链接", "运行时限制"]
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0 },
        "when": { "$ref": "#/definitions/predicate" },
        "capture": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["field", "regex"],
            "additionalProperties": false,
            "properties": {
              "field": { "$ref": "#/definitions/field" },
              "regex": { "type": "string", "minLength": 1 }
            }
          }
        },
        "human": { "$ref": "#/definitions/i18n" },
        "hint": { "$ref": "#/definitions/i18n" },
        "example": { "type": "string" },
        "docs": { "type": "string" },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["message", "expect"],
            "additionalProperties": false,
            "properties": {
              "message": { "type": "string" },
              "severity": { "enum": ["error", "warning", "fatal error", "note"] },
              "expect": { "type": "boolean" }
            }
          }
        }
      }
    },
    "field": {
      "enum": ["severity", "message", "file", "line", "column", "sourceLine", "lang"]
    },
    "op": {
      "enum": ["contains", "startsWith", "endsWith", "equals", "in", "regex", "present"]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/predicate" }
            }
          }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/predicate" }
            }
          }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": { "not": { "$ref": "#/definitions/predicate" } }
        },
        {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/definitions/field" },
            "op": { "$ref": "#/definitions/op" },
            "value": {}
          },
          "allOf": [
            {
              "if": { "properties": { "op": { "enum": ["contains", "startsWith", "endsWith", "equals", "regex"] } }, "required": ["op"] },
              "then": { "required": ["value"], "properties": { "value": { "type": "string" } } }
            },
            {
              "if": { "properties": { "op": { "const": "in" } }, "required": ["op"] },
              "then": { "required": ["value"], "properties": { "value": { "type": "array", "items": { "type": "string" } } } }
            }
          ]
        }
      ]
    }
  }
}
